<?php

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\node\NodeInterface;
use Drupal\saibher_bms_core\Service\InventoryMovementsInterface;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Template\Attribute;
use Drupal\Core\Url;
use Drupal\taxonomy\TermInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\Sql;

/**
 * Implements hook_theme().
 */
function saibher_bms_core_theme(): array {
  return [
    'saibher_bms_core_page' => [
      'variables' => [
        'title' => '',
        'subtitle' => '',
        'icon' => 'apps',
        'action_label' => '',
        'action_url' => '',
        'secondary_action_label' => '',
        'table' => [],
        'modal_form' => [],
        'secondary_modal_form' => [],
      ],
      'template' => 'saibher-bms-core-page',
      'path' => 'modules/custom/saibher_bms_core/templates',
    ],
    'saibher_bms_core_billing_form' => [
      'variables' => [
        'title' => '',
        'subtitle' => '',
        'icon' => 'receipt_long',
        'back_route' => 'saibher_bms_core.billing',
        'back_label' => 'Volver a Facturas de venta',
        'party_label' => 'Cliente',
        'party_key' => 'cliente',
        'document_label' => 'factura',
        'document_title' => 'Factura',
      ],
      'template' => 'saibher-billing-form',
      'path' => 'modules/custom/saibher_bms_core/templates',
    ],
    'saibher_bms_core_config_page' => [
      'variables' => [
        'title' => '',
        'subtitle' => '',
        'icon' => 'settings',
        'form' => [],
      ],
      'template' => 'saibher-config-page',
      'path' => 'modules/custom/saibher_bms_core/templates',
    ],
    'saibher_bms_core_cash_report' => [
      'variables' => [
        'title' => '',
        'subtitle' => '',
        'period_label' => '',
        'periods' => [],
        'series' => [],
        'range' => [],
        'report' => [],
        'documents_label' => '',
        'has_data' => FALSE,
      ],
      'template' => 'saibher-cash-report',
      'path' => 'modules/custom/saibher_bms_core/templates',
    ],
  ];
}

/**
 * Removes the duplicate menu definitions owned by this module.
 *
 * The existing Saibher menu module is the single source for the main menu;
 * its links now target these operational routes. The "Inicio" link provided
 * by the standard install profile (standard.front_page) is also removed: the
 * sidebar entry point is the brand link in the header of the lateral menu.
 */
function saibher_bms_core_menu_links_discovered_alter(array &$links): void {
  foreach ([
    'standard.front_page',
    'saibher_bms_core.billing',
    'saibher_bms_core.inventory',
    'saibher_bms_core.movements',
    'saibher_bms_core.customers',
    'saibher_bms_core.suppliers',
  ] as $link_id) {
    unset($links[$link_id]);
  }
}

/**
 * Implements hook_preprocess_views_view_table().
 *
 * Adds consistent view/edit/delete icon actions to Saibher tables without
 * changing the existing View field configuration. The movements table is
 * read-only (no action buttons) and only receives spacing/presentation
 * tweaks via a dedicated CSS class.
 */
function saibher_bms_core_preprocess_views_view_table(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if ($view === NULL || !in_array($view->id(), [
    'saibher_documents',
    'saibher_financial_register',
    'saibher_movements',
    'saibher_customers',
    'saibher_suppliers',
    'saibher_inventory',
    'saibher_categories',
  ], true)) {
    return;
  }

  // Movimientos es una tabla de solo lectura: no se añaden acciones. La
  // entrada aquí solo sirve para marcar la tabla y darle aire a las celdas.
  if ($view->id() === 'saibher_movements') {
    if (!isset($variables['attributes']) || !$variables['attributes'] instanceof Attribute) {
      $variables['attributes'] = new Attribute();
    }
    $variables['attributes']->addClass('saibher-movements-table');
    return;
  }

  $variables['header']['saibher_actions'] = [
    'content' => t('Acciones'),
    'url' => NULL,
    'title' => '',
    'sort_indicator' => [],
    'attributes' => new Attribute(['class' => ['saibher-table-actions-header']]),
    'default_classes' => true,
    'fields' => ['saibher_actions'],
  ];

  $edit_titles = [
    'saibher_documents' => t('Editar factura'),
    'saibher_financial_register' => t('Editar registro'),
    'saibher_customers' => t('Editar cliente'),
    'saibher_suppliers' => t('Editar proveedor'),
    'saibher_inventory' => t('Editar producto'),
    'saibher_categories' => t('Editar categoría'),
  ];

  // Movements are system-driven records: creation, editing and deletion are
  // performed through the inventory flows, never manually.
  $is_movement = $view->id() === 'saibher_movements';

  foreach ($variables['rows'] as $delta => &$row) {
    $result = $view->result[$delta] ?? NULL;
    $entity = $result?->_entity ?? NULL;
    if ($entity === NULL) {
      continue;
    }

    $entity_type_id = $entity->getEntityTypeId();
    if ($entity_type_id === 'node') {
      $bundle_field = 'node';
      $edit_title = $edit_titles[$view->id()] ?? t('Editar');
    }
    elseif ($entity_type_id === 'taxonomy_term') {
      $bundle_field = 'taxonomy_term';
      $edit_title = $edit_titles[$view->id()] ?? t('Editar');
    }
    else {
      continue;
    }

    // Inventario: las filas con stock por debajo del mínimo se resaltan en
    // rojo (clase sb-row--low-stock, coloreada en admin-pages.css).
    if ($view->id() === 'saibher_inventory'
      && $entity_type_id === 'node'
      && $entity->hasField('field_stock')
      && $entity->hasField('field_min_stock')
      && (float) $entity->get('field_stock')->value < (float) $entity->get('field_min_stock')->value) {
      $row['attributes']->addClass('sb-row--low-stock');
    }

    $entity_id = (int) $entity->id();

    // Documentos: «Editar» lleva al formulario del panel con la fila ya
    // cargada, no al formulario de nodo de Drupal. El tipo almacenado decide
    // cuál de los dos formularios corresponde (factura de venta o de compra).
    $document_form_url = NULL;
    if ($view->id() === 'saibher_documents'
      && $entity_type_id === 'node'
      && $entity->bundle() === 'document'
      && $entity->hasField('field_document_type_document')) {
      $document_form_url = Url::fromRoute(
        // 'Factura de compra' es el valor que escribe el servicio de borradores
        // en field_document_type_document.
        $entity->get('field_document_type_document')->value === 'Factura de compra'
          ? 'saibher_bms_core.purchase_form'
          : 'saibher_bms_core.billing_form',
        ['documento' => $entity_id]
      );
    }

    $actions = [
      '#type' => 'container',
      '#attributes' => ['class' => ['sb-row-actions', 'saibher-table-actions']],
    ];

    // La página de categorías no ofrece la acción "Ver": el término no tiene
    // una página propia de consulta dentro del panel, solo edición y borrado.
    if ($view->id() !== 'saibher_categories') {
      $actions['view'] = [
        '#type' => 'link',
        '#title' => [
          '#markup' => Markup::create('<svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg><span class="sb-visually-hidden">' . t('Ver') . '</span>'),
        ],
        '#url' => Url::fromRoute("entity.{$bundle_field}.canonical", [$bundle_field => $entity_id]),
        '#attributes' => [
        'class' => ['saibher-icon-button', 'saibher-icon-button--view'],
          'title' => t('Ver'),
          'aria-label' => t('Ver'),
        ],
      ];
    }

    // Una factura que ya salió del estado borrador no se edita desde la tabla:
    // sus movimientos son parte del histórico del inventario y cambiarla es la
    // función de devoluciones, que todavía no existe.
    $is_closed_document = $document_form_url !== NULL
      && $entity->hasField('field_document_status')
      && $entity->get('field_document_status')->value !== 'borrador';

    if (!$is_movement && !$is_closed_document) {
      // Documentos: «Editar» abre el formulario del panel con la fila ya
      // cargada (facturas en /bms/facturar, compras en /bms/comprar), no el
      // formulario de nodo de Drupal dentro de una modal.
      $edit_url = $document_form_url ?? Url::fromRoute(
        "entity.{$bundle_field}.edit_form",
        [$bundle_field => $entity_id]
      );
      $edit_attributes = [
        'class' => ['saibher-icon-button', 'saibher-icon-button--edit'],
        'title' => t('Editar'),
        'aria-label' => t('Editar'),
      ];
      if ($document_form_url === NULL) {
        $edit_attributes['data-dialog-edit'] = Url::fromRoute(
          $bundle_field === 'node' ? 'saibher_bms_core.node_edit_form' : 'saibher_bms_core.term_edit_form',
          [$bundle_field => $entity_id],
        )->toString();
        $edit_attributes['data-dialog-title'] = $edit_title;
      }
      $actions['edit'] = [
        '#type' => 'link',
        '#title' => [
          '#markup' => Markup::create('<svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg><span class="sb-visually-hidden">' . t('Editar') . '</span>'),
        ],
        '#url' => $edit_url,
        '#attributes' => $edit_attributes,
      ];
      $actions['delete'] = [
        '#type' => 'link',
        '#title' => [
          '#markup' => Markup::create('<svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg><span class="sb-visually-hidden">' . t('Eliminar') . '</span>'),
        ],
        '#url' => Url::fromRoute("entity.{$bundle_field}.delete_form", [$bundle_field => $entity_id]),
        '#attributes' => [
          'class' => ['saibher-icon-button', 'saibher-icon-button--danger'],
          'title' => t('Eliminar'),
          'aria-label' => t('Eliminar'),
        ],
      ];
    }

    $row['columns']['saibher_actions'] = [
      'content' => [
        [
          'separator' => '',
          'field_output' => $actions,
        ],
      ],
      'attributes' => new Attribute(['class' => ['saibher-table-actions-cell']]),
      'default_classes' => true,
      'fields' => ['saibher_actions'],
    ];
  }
  unset($row);
}

/**
 * Implements hook_views_query_alter().
 *
 * Aplica el filtro "Solo stock bajo el mínimo" del inventario: compara el
 * stock actual de cada producto con su stock mínimo.
 */
function saibher_bms_core_views_query_alter(ViewExecutable $view, $query): void {
  if ($view->id() !== 'saibher_inventory' || !$query instanceof Sql) {
    return;
  }
  if (!\Drupal::request()->query->get('bajo_stock')) {
    return;
  }
  $stock_alias = $query->ensureTable('node__field_stock');
  $min_alias = $query->ensureTable('node__field_min_stock');
  if ($stock_alias && $min_alias) {
    $query->addWhereExpression(0, "{$stock_alias}.field_stock_value < {$min_alias}.field_min_stock_value");
  }
}

/**
 * Implements hook_form_alter().
 *
 * Removes administrative/metadata elements (publishing state, authoring,
 * URL alias, revision log, language, and the product status toggles) from
 * the node forms used by the operational panel, and trims the taxonomy term
 * (category) form so only the name (and description/image when present) are
 * shown in the "crear categoría" modal.
 */
function saibher_bms_core_form_alter(&$form, FormStateInterface $form_state, string $form_id): void {
  // Los formularios de nodo/término del panel usan field_group "details":
  // todos los grupos (incluido "Detalles") vienen abiertos por defecto.
  if ($form_id === 'node_product_form'
    || $form_id === 'node_product_edit_form'
    || $form_id === 'taxonomy_term_category_form'
    || $form_id === 'taxonomy_term_category_edit_form') {
    $open_details = static function (array &$element) use (&$open_details): void {
      if (($element['#type'] ?? NULL) === 'details') {
        $element['#open'] = TRUE;
      }
      foreach (\Drupal\Core\Render\Element::children($element) as $child) {
        $open_details($element[$child]);
      }
    };
    $open_details($form);

    // El alta/edición de producto viaja por el panel, no por las páginas
    // estándar de nodo: se retiran el botón "Vista previa" y el de eliminar
    // el nodo de las acciones (el borrado se gestiona desde la tabla).
    if ($form_id === 'node_product_form'
      || $form_id === 'node_product_edit_form') {
      foreach (['preview', 'delete'] as $action) {
        if (isset($form['actions'][$action])) {
          unset($form['actions'][$action]);
        }
      }
    }
  }
  // El formulario expuesto de Views se identifica por su form id
  // "views_exposed_form" (compartido por todas las vistas); cada vista se
  // distingue por la acción (#action) del formulario.
  // Buscador de la tabla de categorías: "Buscar" pasa a ser placeholder y el
  // botón "Aplicar" adopta los estilos de botón del sitio, en línea.
  if ($form_id === 'views_exposed_form'
    && str_contains((string) ($form['#action'] ?? ''), 'bms/categorias')
    && isset($form['name'])) {
    $form['name']['#title_display'] = 'invisible';
    $form['name']['#attributes']['class'][] = 'sb-input';
    $form['name']['#attributes']['placeholder'] = t('Buscar por nombre');
    $submit = $form['actions']['submit'] ?? $form['submit'] ?? NULL;
    if ($submit !== NULL) {
      $form['actions']['submit']['#attributes']['class'][] = 'saibher-btn';
      $form['actions']['submit']['#attributes']['class'][] = 'saibher-btn--primary';
    }
  }

  // Filtros expuestos de la tabla de Inventario: nombre (contiene), código
  // (exacto) y categoría (select único), con los estilos del sitio y todo en
  // línea; los títulos pasan a ser placeholders y el botón dice "Buscar".
  if ($form_id === 'views_exposed_form'
    && str_contains((string) ($form['#action'] ?? ''), 'bms/inventario')) {
    foreach (['nombre' => 'Nombre', 'codigo' => 'Código'] as $key => $placeholder) {
      if (isset($form[$key])) {
        $form[$key]['#title_display'] = 'invisible';
        $form[$key]['#attributes']['class'][] = 'sb-input';
        $form[$key]['#attributes']['placeholder'] = $placeholder;
      }
    }
    if (isset($form['categoria'])) {
      $form['categoria']['#title_display'] = 'invisible';
      $form['categoria']['#attributes']['class'][] = 'sb-select';
      $form['categoria']['#prefix'] = '<div class="sb-select-wrap">';
      $form['categoria']['#suffix'] = '</div>';
      foreach (array_keys($form['categoria']['#options'] ?? []) as $key) {
        if ($key === '' || (string) $key === '0' || in_array((string) $key, ['all', 'All'], TRUE)) {
          $form['categoria']['#options'][$key] = t('Categoría');
        }
      }
    }
    if (!isset($form['bajo_stock'])) {
      // Control "Bajo stock": toggle tipo app móvil (estilos .sb-toggle del
      // tema). Se renderiza como markup porque el tema checkbox de Drupal no
      // soporta #prefix/#suffix; el input homónimo viaja en el GET del form.
      $checked = (bool) \Drupal::request()->query->get('bajo_stock');
      $form['bajo_stock'] = [
        '#type' => 'markup',
        '#markup' => Markup::create('<label class="sb-toggle">'
          . '<input type="checkbox" name="bajo_stock" value="1" id="edit-bajo-stock"'
          . ' data-drupal-selector="edit-bajo-stock" class="sb-toggle__input sb-checkbox"'
          . ($checked ? ' checked' : '') . '>'
          . '<span class="sb-toggle__track"><span class="sb-toggle__thumb"></span></span>'
          . '<span class="sb-toggle__label">' . t('Bajo stock') . '</span>'
          . '</label>'),
      ];
    }
    $submit = $form['actions']['submit'] ?? $form['submit'] ?? NULL;
    if ($submit !== NULL) {
      $form['actions']['submit']['#attributes']['class'][] = 'saibher-btn';
      $form['actions']['submit']['#attributes']['class'][] = 'saibher-btn--primary';
      $form['actions']['submit']['#value'] = t('Buscar');
    }
  }

  // Filtros expuestos de la tabla de Movimientos: SKU/código, producto y
  // referencia (contiene) y tipo de movimiento (select). Mismo tratamiento
  // visual que el inventario: títulos como placeholders y botón "Buscar".
  if ($form_id === 'views_exposed_form'
    && str_contains((string) ($form['#action'] ?? ''), 'bms/movimientos')) {
    foreach (['sku_codigo' => 'SKU / código', 'producto' => 'Producto', 'referencia' => 'Referencia'] as $key => $placeholder) {
      if (isset($form[$key])) {
        $form[$key]['#title_display'] = 'invisible';
        $form[$key]['#attributes']['class'][] = 'sb-input';
        $form[$key]['#attributes']['placeholder'] = $placeholder;
      }
    }
    if (isset($form['tipo'])) {
      $form['tipo']['#title_display'] = 'invisible';
      $form['tipo']['#attributes']['class'][] = 'sb-select';
      $form['tipo']['#prefix'] = '<div class="sb-select-wrap">';
      $form['tipo']['#suffix'] = '</div>';
      foreach (array_keys($form['tipo']['#options'] ?? []) as $key) {
        if ($key === '' || (string) $key === '0' || in_array((string) $key, ['all', 'All'], TRUE)) {
          $form['tipo']['#options'][$key] = t('Tipo de movimiento');
        }
      }
    }
    $submit = $form['actions']['submit'] ?? $form['submit'] ?? NULL;
    if ($submit !== NULL) {
      $form['actions']['submit']['#attributes']['class'][] = 'saibher-btn';
      $form['actions']['submit']['#attributes']['class'][] = 'saibher-btn--primary';
      $form['actions']['submit']['#value'] = t('Buscar');
    }
  }

  // Filtros expuestos de la tabla de Facturas de venta: documento (contiene).
  // Mismo tratamiento visual que el buscador de Categorías: título como
  // placeholder, input con estilos del sitio y botón "Buscar" en línea.
  if ($form_id === 'views_exposed_form'
    && str_contains((string) ($form['#action'] ?? ''), 'bms/facturacion')
    && isset($form['documento'])) {
    $form['documento']['#title_display'] = 'invisible';
    $form['documento']['#attributes']['class'][] = 'sb-input';
    $form['documento']['#attributes']['placeholder'] = t('Buscar por documento');
    $submit = $form['actions']['submit'] ?? $form['submit'] ?? NULL;
    if ($submit !== NULL) {
      $form['actions']['submit']['#attributes']['class'][] = 'saibher-btn';
      $form['actions']['submit']['#attributes']['class'][] = 'saibher-btn--primary';
      $form['actions']['submit']['#value'] = t('Buscar');
    }
  }

  // Filtros expuestos de las tablas de Clientes y Proveedores: nombre,
  // contacto, documento y teléfono/correo, todos como texto en línea con
  // placeholder; el botón dice "Buscar". El formulario agrupa los cinco
  // campos y puede fluir a varias líneas (clase .saibher-exposed-filters).
  if ($form_id === 'views_exposed_form'
    && (str_contains((string) ($form['#action'] ?? ''), 'bms/clientes')
      || str_contains((string) ($form['#action'] ?? ''), 'bms/proveedores'))) {
    $form['#attributes']['class'][] = 'saibher-exposed-filters';
    foreach (['nombre' => 'Nombre', 'contacto' => 'Contacto', 'documento' => 'Documento', 'telefono' => 'Teléfono', 'correo' => 'Correo'] as $key => $placeholder) {
      if (isset($form[$key])) {
        $form[$key]['#title_display'] = 'invisible';
        $form[$key]['#attributes']['class'][] = 'sb-input';
        $form[$key]['#attributes']['placeholder'] = $placeholder;
      }
    }
    $submit = $form['actions']['submit'] ?? $form['submit'] ?? NULL;
    if ($submit !== NULL) {
      $form['actions']['submit']['#attributes']['class'][] = 'saibher-btn';
      $form['actions']['submit']['#attributes']['class'][] = 'saibher-btn--primary';
      $form['actions']['submit']['#value'] = t('Buscar');
    }
  }

  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return;
  }

  $entity = $form_object->getEntity();

  if ($entity instanceof TermInterface) {
    if ($entity->bundle() !== 'category') {
      return;
    }
    // En el modal de creación de categoría solo interesan nombre e imagen;
    // se eliminan descripción, relaciones, información de revisión y el resto
    // de chrome administrativo.
    foreach ([
      'description',
      'relations',
      'revision_information',
      'revision_log_message',
      'status',
      'path',
      'langcode',
    ] as $name) {
      if (isset($form[$name])) {
        unset($form[$name]);
      }
    }
    // Solo se conserva el botón "Guardar"; se retira "Guardar e ir a la lista".
    if (isset($form['actions']['overview'])) {
      unset($form['actions']['overview']);
    }
    // Al ocultar el grupo "Relaciones" (campo parent) el núcleo de Drupal
    // espera un valor para construir la entidad; sin él, TermForm lanza un
    // TypeError tanto al guardar como al abrir la Media Library (AJAX).
    // El handler se antepone porque TermForm::validateForm() (que ejecuta
    // buildEntity()) corre antes que los validadores añadidos al final.
    array_unshift($form['#validate'], 'saibher_bms_core_category_parent_default');
    return;
  }

  if (!$entity instanceof NodeInterface) {
    return;
  }

  $bundle = $entity->bundle();
  if (!in_array($bundle, ['product', 'customer', 'supplier', 'movement', 'document'], true)) {
    return;
  }

  $hidden = [
    'status',
    'promote',
    'sticky',
    'created',
    'uid',
    'path',
    'revision_log',
    'langcode',
  ];
  if ($bundle === 'product') {
    $hidden[] = 'field_active';
    $hidden[] = 'field_public_webpage';
  }

  foreach ($hidden as $name) {
    if (isset($form[$name])) {
      unset($form[$name]);
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * When a category is created (or edited) from the inventory modal, send the
 * user back to the inventory page instead of the taxonomy admin overview.
 */
function saibher_bms_core_form_taxonomy_term_category_form_alter(&$form, FormStateInterface $form_state, string $form_id): void {
  $form['#submit'][] = 'saibher_bms_core_category_redirect_submit';
  // Al pulsar el botón, el núcleo ejecuta solo los handlers del botón
  // (['::submitForm', '::save']), ignorando el nivel superior de '#submit'.
  // TermForm::save redirige al canal del término; se añade nuestro handler
  // después de '::save' para devolver al usuario a la página del panel.
  if (isset($form['actions']['submit']['#submit']) && is_array($form['actions']['submit']['#submit'])) {
    $form['actions']['submit']['#submit'][] = 'saibher_bms_core_category_redirect_submit';
  }
}

/**
 * Redirect handler for the category form opened from the operational modal.
 *
 * Sends the user back to the page that opened the modal (inventario or
 * categorías) instead of the taxonomy admin overview.
 */
function saibher_bms_core_category_redirect_submit(array &$form, FormStateInterface $form_state): void {
  $route = 'saibher_bms_core.inventory';
  $referer = \Drupal::request()->headers->get('referer');
  if ($referer) {
    try {
      $parsed = parse_url($referer, PHP_URL_PATH);
      if ($parsed !== NULL && $parsed !== FALSE) {
        $match = \Drupal::service('router')->matchRequest(\Drupal::request()->create($parsed));
        if (in_array($match['_route'] ?? NULL, ['saibher_bms_core.inventory', 'saibher_bms_core.categories'], true)) {
          $route = $match['_route'];
        }
      }
    }
    catch (\Exception $e) {
      // Fallback to inventory when the referer cannot be matched.
    }
  }
  $form_state->setRedirect($route);
}

/**
 * Validation handler for the category (taxonomy term) form.
 *
 * The "Relaciones" group (parent field) is hidden in the modal, so a default
 * top-level parent value is provided for TermForm::buildEntity(), which
 * requires the value to exist.
 */
function saibher_bms_core_category_parent_default(array &$form, FormStateInterface $form_state): void {
  if (!$form_state->hasValue('parent')) {
    $form_state->setValue('parent', ['0']);
  }
}

/**
 * Implements hook_preprocess_node().
 *
 * Prepares the data of the detail pages (node--*--full) of the Saibher
 * panel: product (image, states, KPIs, movements), customer (cartera,
 * KPIs, contacto, sucursales, compras) and supplier (KPIs, contacto,
 * sucursales, productos asociados). Each ficha is built by a dedicated
 * helper that only uses real data — never invented metrics.
 */
function saibher_bms_core_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }
  if (($variables['view_mode'] ?? 'full') !== 'full') {
    return;
  }

  $bundle = $node->bundle();
  if ($bundle === 'product') {
    saibher_bms_core_build_product_ficha($node, $variables);
    return;
  }
  if ($bundle === 'customer') {
    $variables['ficha'] = saibher_bms_core_build_customer_ficha($node);
    return;
  }
  if ($bundle === 'supplier') {
    $variables['ficha'] = saibher_bms_core_build_supplier_ficha($node);
    return;
  }
  if ($bundle === 'document') {
    $variables['ficha'] = saibher_bms_core_build_document_ficha($node);
  }
}

/**
 * Builds the ficha data of the product detail page (node--product--full):
 * product image, states, KPIs (stock, prices, margin, units sold), the
 * movements history linked to this product and the provider placeholder
 * (there is no supplier relationship on products yet).
 */
function saibher_bms_core_build_product_ficha(NodeInterface $node, array &$variables): void {
  $title = $node->label();
  $sku = (string) ($node->get('field_sku')->value ?? '');
  $code = (string) ($node->get('field_code')->value ?? '');
  $stock = (float) ($node->get('field_stock')->value ?? 0.0);
  $min_stock = (float) ($node->get('field_min_stock')->value ?? 0.0);
  $pvp = (float) ($node->get('field_pvp')->value ?? 0.0);
  $cost = (float) ($node->get('field_cost')->value ?? 0.0);

  $category = NULL;
  if (!$node->get('field_category')->isEmpty()) {
    $term = $node->get('field_category')->entity;
    $category = $term instanceof TermInterface ? $term->label() : NULL;
  }

  $image_url = NULL;
  if (!$node->get('field_image')->isEmpty()) {
    /** @var \Drupal\media\MediaInterface|null $media */
    $media = $node->get('field_image')->entity;
    if ($media !== NULL && method_exists($media, 'getFileUri')) {
      $image_url = \Drupal::service('file_url_generator')->generateString($media->getFileUri());
    }
  }

  $description = '';
  if (!$node->get('field_description')->isEmpty()) {
    $description_value = $node->get('field_description')->value ?? '';
    $description_format = $node->get('field_description')->format ?? '';
    $description = $description_format !== '' && function_exists('check_markup')
      ? Markup::create(check_markup($description_value, $description_format))
      : $description_value;
  }

  $movements = [];
  $units_sold = 0.0;
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $date_formatter = \Drupal::service('date.formatter');

  // Los movimientos de una factura que sigue en borrador son temporales: la
  // línea se puede quitar o cambiar de cantidad, así que no cuentan como
  // unidades vendidas ni aparecen en el historial del producto. El estado de
  // cada documento se lee una sola vez.
  $draft_documents = [];
  $is_temporary = static function (NodeInterface $movement) use (&$draft_documents): bool {
    $document = $movement->hasField('field_movement_document')
      ? $movement->get('field_movement_document')->entity
      : NULL;
    if (!$document instanceof NodeInterface) {
      return FALSE;
    }
    $document_id = (int) $document->id();
    if (!isset($draft_documents[$document_id])) {
      $draft_documents[$document_id] = !$document->hasField('field_document_status')
        || $document->get('field_document_status')->value === 'borrador';
    }
    return $draft_documents[$document_id];
  };

  if ($sku !== '' || $title !== '') {
    // Estadística de "unidades vendidas" sobre todos los movimientos.
    $all_movements = $storage->loadByProperties(['type' => 'movement', 'status' => 1]);
    foreach ($all_movements as $movement) {
      if (!$movement instanceof NodeInterface) {
        continue;
      }
      $movement_sku = (string) ($movement->get('field_product_code')->value ?? '');
      $movement_product = (string) ($movement->get('field_product')->value ?? '');
      $matches = ($sku !== '' && $movement_sku === $sku) || $movement_product === $title;
      $is_sale = stripos((string) ($movement->get('field_movement_type')->value ?? ''), 'salida') !== FALSE;
      if ($matches && $is_sale && !$is_temporary($movement)) {
        $units_sold += (float) ($movement->get('field_quantity')->value ?? 0.0);
      }
    }

    // Historial reciente (máximo 10) para la tabla de movimientos.
    $query = \Drupal::entityQuery('node')
      ->accessCheck(FALSE)
      ->condition('type', 'movement')
      ->condition('status', 1)
      ->sort('created', 'DESC')
      ->range(0, 10);
    $matches = $query->orConditionGroup();
    if ($sku !== '') {
      $matches->condition('field_product_code', $sku);
    }
    $matches->condition('field_product', $title);
    $query->condition($matches);
    foreach ($query->execute() as $movement_id) {
      $movement = $storage->load($movement_id);
      if (!$movement instanceof NodeInterface || $is_temporary($movement)) {
        continue;
      }
      $quantity = (float) ($movement->get('field_quantity')->value ?? 0.0);
      $quantity_label = $quantity == floor($quantity)
        ? number_format((int) $quantity, 0, '.', ',')
        : rtrim(rtrim(number_format($quantity, 2, '.', ','), '0'), ',');
      $owner_label = '';
      try {
        $owner = $movement->getOwner();
        $owner_label = $owner instanceof \Drupal\user\UserInterface ? $owner->label() : '';
      }
      catch (\Exception $e) {
        $owner_label = '';
      }
      $movements[] = [
        'date' => $date_formatter->format($movement->getCreatedTime(), 'custom', 'd/m/Y, g:i a'),
        'type' => (string) ($movement->get('field_movement_type')->value ?? ''),
        'quantity' => $quantity_label,
        'reference' => (string) ($movement->get('field_reference')->value ?? ''),
        'user' => $owner_label,
      ];
    }
  }

  $margin = $pvp - $cost;
  $margin_pct = $pvp > 0 ? (int) round(($margin / $pvp) * 100) : 0;

  $variables['ficha'] = [
    'title' => $title,
    'subtitle' => implode(' · ', array_filter([$sku !== '' ? 'SKU ' . $sku : NULL, $category])),
    'sku' => $sku,
    'code' => $code,
    'category' => $category,
    'active' => (bool) ($node->get('field_active')->value ?? FALSE),
    'image_url' => $image_url,
    'description' => $description,
    'stock' => (int) $stock,
    'min_stock' => (int) $min_stock,
    'units_sold' => (int) $units_sold,
    'cost' => $cost,
    'pvp' => $pvp,
    'margin' => $margin,
    'margin_pct' => $margin_pct,
    'movements' => $movements,
  ];

  // Proveedor: los productos aún no tienen una relación con el contenido
  // "supplier", así que la tarjeta no se muestra hasta que exista el vínculo.
  $variables['ficha']['supplier'] = [
    'name' => '',
    'nit' => '',
    'contact' => '',
    'phone' => '',
    'email' => '',
    'url' => Url::fromRoute('saibher_bms_core.suppliers')->toString(),
  ];
}

/**
 * Builds the ficha data of the customer detail page (node--customer--full).
 *
 * Combina los datos propios del cliente con sus documentos de venta
 * ("document" que apunte a él) y su cartera ("debtors"): saldo, facturas,
 * total comprado, contacto, sucursales y las compras registradas.
 * Las métricas sin campo asociado (cupo de crédito/disponible) se muestran
 * como "—" en vez de inventar valores.
 */
function saibher_bms_core_build_customer_ficha(NodeInterface $node): array {
  $title = $node->label();
  $document = (string) ($node->get('field_document_nunber')->value ?? '');
  $document_type = '';
  if (!$node->get('field_document_type_customer')->isEmpty()) {
    $term = $node->get('field_document_type_customer')->entity;
    $document_type = $term instanceof TermInterface ? $term->label() : '';
  }
  $phone = (string) ($node->get('field_phone_customer')->value ?? '');
  $email = (string) ($node->get('field_email_customer')->value ?? '');
  $address = (string) ($node->get('field_main_address')->value ?? '');

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $date_formatter = \Drupal::service('date.formatter');

  $document_ids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'document')
    ->condition('status', 1)
    ->condition('field_customer_document', $node->id())
    ->sort('created', 'DESC')
    ->execute();

  $debt_ids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'debtors')
    ->condition('status', 1)
    ->condition('field_customer_debtors', $node->id())
    ->execute();

  $balance = 0.0;
  foreach ($storage->loadMultiple($debt_ids) as $debt) {
    $balance += (float) ($debt->get('field_value')->value ?? 0.0);
  }

  $credit_limit = NULL;
  if (!$node->get('field_credit_limit')->isEmpty()) {
    $credit_limit = (float) $node->get('field_credit_limit')->value;
  }
  $credit_available = $credit_limit !== NULL ? $credit_limit - $balance : NULL;

  $purchases = [];
  $total_purchased = 0.0;
  foreach ($storage->loadMultiple($document_ids) as $doc) {
    $total = (float) ($doc->get('field_total')->value ?? 0.0);
    $total_purchased += $total;

    $paid = 0.0;
    $payment_labels = [];
    foreach ($doc->get('field_payment_document') as $item) {
      $payment = $item->entity;
      if ($payment === NULL) {
        continue;
      }
      $paid += (float) ($payment->get('field_quantity')->value ?? 0.0);
      $method = $payment->get('field_method')->entity;
      if ($method instanceof TermInterface) {
        $payment_labels[] = $method->label();
      }
    }

    $prefix = '';
    if (!$doc->get('field_document_prefix')->isEmpty()) {
      $prefix_term = $doc->get('field_document_prefix')->entity;
      if ($prefix_term instanceof TermInterface) {
        // Los prefijos del vocabulario combinan código y descripción
        // ("FV - Factura de venta"); el folio usa solo el código ("FV").
        $prefix = explode(' - ', trim($prefix_term->label()), 2)[0];
      }
    }
    $number = (string) ($doc->get('field_document_number')->value ?? '');
    $folio = $prefix !== '' && $number !== '' ? $prefix . '-' . $number : ($prefix ?: $number);
    $status = $total > 0 && $paid < $total ? 'Pendiente' : 'Pagada';

    $purchases[] = [
      'folio' => $folio !== '' ? $folio : '—',
      'date' => $date_formatter->format($doc->getCreatedTime(), 'custom', 'd/m/Y'),
      'payment' => implode(', ', $payment_labels) ?: '—',
      'status' => $status,
      'status_class' => $status === 'Pagada' ? 'success' : 'warning',
      'total_display' => saibher_bms_core_money($total),
    ];
  }

  $last_movement = '';
  $first_doc_id = $document_ids ? reset($document_ids) : NULL;
  if ($first_doc_id !== NULL && $first_doc_id !== FALSE) {
    $doc = $storage->load($first_doc_id);
    if ($doc instanceof NodeInterface) {
      $last_movement = $date_formatter->format($doc->getCreatedTime(), 'custom', 'd/m/Y');
    }
  }

  return [
    'type' => 'cliente',
    'title' => $title,
    'subtitle' => implode(' · ', array_filter([
      $document !== '' ? ($document_type !== '' ? $document_type . ' ' . $document : $document) : NULL,
    ])),
    'document' => $document,
    'document_type' => $document_type ?: '—',
    'phone' => $phone,
    'email' => $email,
    'address' => $address,
    'balance' => (float) $balance,
    'last_movement' => $last_movement,
    'credit_limit_display' => saibher_bms_core_money($credit_limit),
    'balance_display' => saibher_bms_core_money((float) $balance),
    'credit_available_display' => saibher_bms_core_money($credit_available),
    'invoices_display' => (string) count($document_ids),
    'total_purchased_display' => saibher_bms_core_money($total_purchased),
    'customer_type' => $document_type ?: '—',
    'locations' => saibher_bms_core_collect_locations($node),
    'purchases' => $purchases,
  ];
}

/**
 * Builds the ficha data of the supplier detail page (node--supplier--full).
 *
 * Datos propios del proveedor (documento, contacto, persona de contacto,
 * sucursales). Los productos aún no referencian proveedor y los documentos
 * de compra no enlazan proveedores: esas métricas y tablas se muestran en
 * cero / vacías hasta que exista la relación en el modelo de datos.
 */
function saibher_bms_core_build_supplier_ficha(NodeInterface $node): array {
  $title = $node->label();
  $document = (string) ($node->get('field_document_nunber')->value ?? '');
  $document_type = '';
  if (!$node->get('field_document_type_supplier')->isEmpty()) {
    $term = $node->get('field_document_type_supplier')->entity;
    $document_type = $term instanceof TermInterface ? $term->label() : '';
  }
  $phone = (string) ($node->get('field_phone_supplier')->value ?? '');
  $email = (string) ($node->get('field_email_supplier')->value ?? '');
  $address = (string) ($node->get('field_main_address')->value ?? '');
  $contact_person = (string) ($node->get('field_person_name')->value ?? '');

  return [
    'type' => 'proveedor',
    'title' => $title,
    'subtitle' => implode(' · ', array_filter([
      $document !== '' ? ($document_type !== '' ? $document_type . ' ' . $document : $document) : NULL,
    ])),
    'document' => $document,
    'phone' => $phone,
    'email' => $email,
    'address' => $address,
    'active' => (bool) ($node->status->value ?? FALSE),
    'note' => '',
    'products_display' => '0',
    'inventory_display' => saibher_bms_core_money(0.0),
    'purchases_display' => '0',
    'total_display' => saibher_bms_core_money(0.0),
    'contact_person' => $contact_person ?: '—',
    'locations' => saibher_bms_core_collect_locations($node),
    'products' => [],
    'purchases' => [],
  ];
}

/**
 * Builds the ficha data of the invoice detail page (node--document--full).
 *
 * Encabezado (código y tipo), tercero (cliente o proveedor, fecha, medio de
 * pago), líneas del detalle y resumen de totales. Todo sale de lo que quedó
 * guardado en el documento: los totales son los campos que escribió
 * DocumentDraft, nunca recalculados aquí, para que la vista y el documento no
 * puedan contradecirse.
 */
function saibher_bms_core_build_document_ficha(NodeInterface $node): array {
  $type_label = (string) ($node->get('field_document_type_document')->value ?? '');
  $status = (string) ($node->get('field_document_status')->value ?? '');
  $status_labels = [
    'borrador' => 'Borrador',
    'pendiente_pago' => 'Lista, pendiente de pago',
    'pagada' => 'Pagada',
    'cerrada' => 'Cerrada',
  ];
  $status_classes = [
    'borrador' => 'neutral',
    'pendiente_pago' => 'warning',
    'pagada' => 'success',
    'cerrada' => 'neutral',
  ];

  // El título del nodo guarda el código ("FV-00005") cuando hay prefijo y
  // numeración; sin prefijo el título es el propio tipo de documento.
  $stored_title = $node->label();
  $code = $stored_title !== '' && $stored_title !== $type_label ? $stored_title : '';
  $noun = $type_label !== '' ? explode(' ', $type_label)[0] : '';
  $title = $code !== ''
    ? trim($noun . ' ' . $code)
    : ($type_label !== '' ? $type_label : 'Documento');

  $party = $node->get('field_customer_document')->entity;
  $party_name = $party instanceof NodeInterface ? $party->label() : '';
  $party_url = '';
  if ($party instanceof NodeInterface && $party->hasLinkTemplate('canonical')) {
    $party_url = $party->toUrl('canonical')->toString();
  }

  $payment_methods = [];
  foreach ($node->get('field_payment_document')->referencedEntities() as $payment) {
    if (!$payment instanceof ParagraphInterface) {
      continue;
    }
    $method = $payment->get('field_method')->entity;
    if ($method instanceof TermInterface) {
      $payment_methods[] = $method->label();
    }
  }

  $items = [];
  $units = 0.0;
  foreach ($node->get('field_document_item')->referencedEntities() as $item) {
    if (!$item instanceof ParagraphInterface) {
      continue;
    }
    $quantity = (float) ($item->get('field_quantity')->value ?? 0.0);
    $units += $quantity;

    $name = (string) ($item->get('field_product')->value ?? '');

    $product = $item->get('field_product_node')->entity;
    if (!$product instanceof NodeInterface && $name !== '') {
      // Líneas creadas antes de field_product_node: se recupera el producto
      // por nombre exacto para mostrar su código y enlazarlo.
      $found = \Drupal::entityTypeManager()->getStorage('node')
        ->loadByProperties(['type' => 'product', 'title' => $name]);
      $product = $found ? reset($found) : NULL;
      if (!$product instanceof NodeInterface) {
        $product = NULL;
      }
    }
    if ($name === '' && $product instanceof NodeInterface) {
      $name = $product->label();
    }

    $item_code = '';
    $product_url = '';
    if ($product instanceof NodeInterface) {
      $item_code = (string) ($product->get('field_code')->value ?? '');
      if ($item_code === '') {
        $item_code = (string) ($product->get('field_sku')->value ?? '');
      }
      if ($product->hasLinkTemplate('canonical')) {
        $product_url = $product->toUrl('canonical')->toString();
      }
    }

    $items[] = [
      'code' => $item_code,
      'name' => $name,
      'quantity' => saibher_bms_core_quantity($quantity),
      'unit_display' => saibher_bms_core_money((float) ($item->get('field_unit_value')->value ?? 0.0)),
      'total_display' => saibher_bms_core_money((float) ($item->get('field_total')->value ?? 0.0)),
      'url' => $product_url,
    ];
  }

  $date_formatter = \Drupal::service('date.formatter');
  $created = $node->getCreatedTime();
  $date_display = $date_formatter->format($created, 'custom', 'd/m/Y, g:i', NULL, 'es');
  $date_display .= ((int) $date_formatter->format($created, 'custom', 'G', NULL, 'es')) < 12 ? ' a. m.' : ' p. m.';

  return [
    'type' => 'documento',
    'title' => $title,
    'subtitle' => $code !== '' ? $type_label : '',
    'code' => $code,
    'type_label' => $type_label,
    'status' => $status,
    'status_label' => $status_labels[$status] ?? ($status !== '' ? $status : '—'),
    'status_class' => $status_classes[$status] ?? 'neutral',
    'party_name' => $party_name !== '' ? $party_name : '—',
    'party_url' => $party_url,
    'date_display' => $date_display,
    'payment_display' => $payment_methods !== []
      ? 'Pago: ' . implode(', ', $payment_methods)
      : 'Sin pagos registrados',
    'units_display' => saibher_bms_core_quantity((float) $units),
    'units_label' => abs($units - 1) < 0.0005 ? 'unidad' : 'unidades',
    'items' => $items,
    'subtotal_display' => saibher_bms_core_money((float) ($node->get('field_subtotal')->value ?? 0.0)),
    'tax_display' => saibher_bms_core_money((float) ($node->get('field_total_tax')->value ?? 0.0)),
    'total_display' => saibher_bms_core_money((float) ($node->get('field_total')->value ?? 0.0)),
  ];
}

/**
 * Formats a quantity without trailing zeros: "6", "1,5", "0,25".
 */
function saibher_bms_core_quantity(float $value): string {
  $value = round($value, 3);
  if (floor($value) == $value) {
    return number_format($value, 0, ',', '.');
  }
  return rtrim(rtrim(number_format($value, 3, ',', '.'), '0'), ',');
}

/**
 * Recopila las sucursales (párrafos "location") referenciadas por un nodo.
 */
function saibher_bms_core_collect_locations(NodeInterface $node): array {
  $locations = [];
  if (!$node->hasField('field_locations')) {
    return $locations;
  }
  foreach ($node->get('field_locations') as $item) {
    $location = $item->entity;
    if (!$location instanceof ParagraphInterface) {
      continue;
    }
    $locations[] = [
      'name' => (string) ($location->get('field_name')->value ?? '') ?: $location->label(),
      'address' => (string) ($location->get('field_address')->value ?? ''),
      'phone' => (string) ($location->get('field_phone_locations')->value ?? ''),
      'manager' => (string) ($location->get('field_person_name')->value ?? ''),
    ];
  }
  return $locations;
}

/**
 * Formatea un monto como moneda del sistema ("$ 8.330,50") o "—" si es NULL.
 *
 * Separadores Colombian: punto para los miles y coma para los decimales, los
 * mismos que usan los formateadores de campos del panel.
 */
function saibher_bms_core_money(?float $value): string {
  if ($value === NULL) {
    return '—';
  }
  $value = round((float) $value, 2);
  return floor($value) == $value
    ? '$ ' . number_format((int) $value, 0, ',', '.')
    : '$ ' . number_format($value, 2, ',', '.');
}

/**
 * Implements hook_entity_delete().
 *
 * Borrar un documento deshace lo que dejó alrededor: sus párrafos de detalle y,
 * si era un borrador, los movimientos provisionales con las unidades que tenían
 * reservadas del almacén.
 */
function saibher_bms_core_entity_delete(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'document') {
    return;
  }

  foreach (['field_document_item', 'field_payment_document'] as $field_name) {
    if (!$entity->hasField($field_name)) {
      continue;
    }
    foreach ($entity->get($field_name)->referencedEntities() as $paragraph) {
      $paragraph->delete();
    }
  }

  /** @var \Drupal\saibher_bms_core\Service\InventoryMovementsInterface $inventory */
  $inventory = \Drupal::service(InventoryMovementsInterface::class);
  $inventory->releaseDraft($entity);
}

/**
 * Implements hook_preprocess_html().
 *
 * Añade una clase al body en las páginas internas del panel (producto,
 * cliente, proveedor) para que la interfaz pueda ocultar el bloque de
 * "page title" duplicado: el page-header de la ficha ya aporta el
 * encabezado.
 */
function saibher_bms_core_preprocess_html(array &$variables): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $classes = [
      'product' => 'sb-ficha-producto',
      'customer' => 'sb-ficha-cliente',
      'supplier' => 'sb-ficha-proveedor',
      'document' => 'sb-ficha-documento',
    ];
    if (isset($classes[$node->bundle()])) {
      $variables['attributes']['class'][] = $classes[$node->bundle()];
    }
  }
}


/**
 * Lee una opción de la configuración general del punto de venta.
 *
 * Fuente única de acceso a `saibher_bms_core.settings`: los formularios, el
 * controlador base y el frontal consumen la configuración a través de esta
 * función en lugar de duplicar lecturas de `\Drupal::config()`.
 */
function saibher_bms_core_pos_setting(string $key, mixed $default = NULL): mixed {
  return \Drupal::config('saibher_bms_core.settings')->get($key) ?? $default;
}

/**
 * Código corto de un prefijo de documento.
 *
 * Los términos del vocabulario `document_prefix` siguen el patrón
 * "CÓDIGO - Descripción" (p. ej. "FV - Factura de venta"); esta función
 * devuelve la parte anterior al separador, que es el código con el que se
 * identifica el prefijo en la numeración.
 */
function saibher_bms_core_prefix_code(mixed $term): string {
  if ($term instanceof TermInterface) {
    $label = trim($term->label());
  }
  else {
    $label = trim((string) $term);
  }
  $sep = mb_strpos($label, ' - ');
  return $sep !== FALSE ? trim(mb_substr($label, 0, $sep)) : $label;
}
